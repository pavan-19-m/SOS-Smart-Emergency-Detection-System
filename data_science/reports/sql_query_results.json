  "Q11": {
    "sql": "SELECT\n    actual_event,\n    random_forest_pred,\n    COUNT(*) AS window_count,\n    ROUND(AVG(random_forest_conf), 4) AS avg_confidence\nFROM test_predictions\nGROUP BY actual_event, random_forest_pred\nORDER BY actual_event, window_count DESC",
    "row_count": 4,
    "rows": [
