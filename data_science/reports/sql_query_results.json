  "Q2": {
    "sql": "SELECT\n    CASE WHEN event_category = 'normal' THEN 'Normal' ELSE 'Potential Emergency' END AS classification_group,\n    COUNT(*) AS event_count,\n    ROUND(100.0 * COUNT(*) / (SELECT COUNT(*) FROM sensor_events), 2) AS pct_share\nFROM sensor_events\nGROUP BY classification_group",
    "row_count": 2,
    "rows": [
      {
        "classification_group": "Normal",
        "event_count": 10299,
        "pct_share": 89.56
      },
      {
        "classification_group": "Potential Emergency",
        "event_count": 1200,
        "pct_share": 10.44
      }
    ]
  },
